<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PythonScriptRunner.EntityFrameworkCore</RootNamespace>
    <Description>PostgreSQL persistence for PythonScriptRunner: catalog with versions and drafts, run history, files, idempotency, outbox, audit and retention.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PythonScriptRunner.Core\PythonScriptRunner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PythonScriptRunner.EntityFrameworkCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

</Project>
