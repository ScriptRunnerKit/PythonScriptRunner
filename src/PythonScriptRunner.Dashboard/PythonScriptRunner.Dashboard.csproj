<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PythonScriptRunner.Dashboard</RootNamespace>
    <Description>Embeddable dashboard for PythonScriptRunner: internal HTTP API, SignalR updates, Vue panel and configurable access (fixed login, custom filter, host authentication or localhost).</Description>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PythonScriptRunner.RabbitMQ\PythonScriptRunner.RabbitMQ.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PythonScriptRunner.Dashboard.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built panel (spec 008); until phase 6 a placeholder page. -->
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>

</Project>
