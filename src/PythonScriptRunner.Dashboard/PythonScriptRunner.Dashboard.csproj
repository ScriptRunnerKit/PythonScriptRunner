<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PythonScriptRunner.Dashboard</RootNamespace>
    <Description>Embeddable dashboard for PythonScriptRunner: internal HTTP API, SignalR updates, Vue panel and configurable access (fixed login, custom filter, host authentication or localhost).</Description>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PythonScriptRunner.RabbitMQ\PythonScriptRunner.RabbitMQ.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PythonScriptRunner.Dashboard.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
  </ItemGroup>

  <!--
    The panel (spec 008) is embedded as wwwroot (D-155): Release builds and packs run `npm ci` + `npm run build` in
    panel/ and embed panel/dist; other builds embed the placeholder page in wwwroot/, so Node is only needed to pack.
    Force either way with -p:PsrBuildPanel=true|false. -p:PsrPanelPrebuilt=true embeds an existing panel/dist without
    running npm (the image build compiles the panel in a Node stage).
  -->
  <PropertyGroup>
    <PsrPanelRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'panel'))</PsrPanelRoot>
    <PsrBuildPanel Condition="'$(PsrBuildPanel)' == '' and '$(Configuration)' == 'Release'">true</PsrBuildPanel>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" Condition="'$(PsrBuildPanel)' != 'true'" />
    <PsrPanelSources Include="$(PsrPanelRoot)src\**\*;$(PsrPanelRoot)public\**\*;$(PsrPanelRoot)index.html;$(PsrPanelRoot)package-lock.json;$(PsrPanelRoot)vite.config.ts" Exclude="$(PsrPanelRoot)src\**\*.spec.ts" />
  </ItemGroup>

  <Target Name="PsrBuildPanel" Condition="'$(PsrBuildPanel)' == 'true' and '$(PsrPanelPrebuilt)' != 'true'" Inputs="@(PsrPanelSources)" Outputs="$(PsrPanelRoot)dist\index.html">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(PsrPanelRoot)" Condition="!Exists('$(PsrPanelRoot)node_modules\.package-lock.json')" />
    <Exec Command="npm run build" WorkingDirectory="$(PsrPanelRoot)" />
  </Target>

  <Target Name="PsrEmbedPanel" DependsOnTargets="PsrBuildPanel" BeforeTargets="_CalculateEmbeddedFilesManifestInputs" Condition="'$(PsrBuildPanel)' == 'true'">
    <ItemGroup>
      <PsrPanelDist Include="$(PsrPanelRoot)dist\**\*" />
      <EmbeddedResource Include="@(PsrPanelDist)" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

</Project>
