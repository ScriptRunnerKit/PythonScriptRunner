<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PythonScriptRunner</RootNamespace>
    <Description>Runs Python stages from .NET with typed inputs/outputs, isolated processes, uv-managed environments and retries.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PythonScriptRunner.Abstractions\PythonScriptRunner.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\schemas\stage.v1.json" LogicalName="PythonScriptRunner.Schemas.stage.v1.json" Link="Schemas\stage.v1.json" />
    <EmbeddedResource Include="..\..\schemas\pipeline.v1.json" LogicalName="PythonScriptRunner.Schemas.pipeline.v1.json" Link="Schemas\pipeline.v1.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PythonScriptRunner.Core.Tests" />
    <!-- The persistence tests reuse the Python fixture of the Core tests (uv lookup). -->
    <InternalsVisibleTo Include="PythonScriptRunner.EntityFrameworkCore.Tests" />
    <InternalsVisibleTo Include="PythonScriptRunner.RabbitMQ.Tests" />
    <InternalsVisibleTo Include="PythonScriptRunner.Worker.Tests" />
    <InternalsVisibleTo Include="PythonScriptRunner.Dashboard.Tests" />
    <InternalsVisibleTo Include="PythonScriptRunner.Panel.E2E.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
